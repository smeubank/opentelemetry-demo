# Template for enabling the Sentry + Supabase integration.
# Copy to `.env.local` (gitignored) and fill in real values, then run `make start`.
# `.env.local` is loaded LAST by the Makefile, so it overrides .env and .env.override.
# Leaving this file absent keeps the default offline demo (bundled Postgres, image-provider,
# anonymous auth, Sentry disabled) working with a plain `docker compose up`.

# ---------------------------------------------------------------------------
# Supabase — database
# ---------------------------------------------------------------------------
# product-catalog (Go / libpq): transaction pooler (:6543), sslmode=require.
# URL-encode special characters in the password (e.g. '*' -> '%2A').
PRODUCT_CATALOG_DB_CONNECTION_STRING=postgres://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# accounting (.NET / Npgsql): session pooler (:5432); Npgsql keyword form (raw password).
ACCOUNTING_DB_CONNECTION_STRING=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Username=postgres.<project-ref>;Password=<password>;Database=postgres;SSL Mode=Require;Trust Server Certificate=true
# load-generator DB-exhaustion task: session pooler (:5432), NOT transaction pooler (:6543).
# Use the libpq keyword/value form (below) so special chars in the password need NO url-encoding.
# (A postgres://user:pass@host/db URL also works, but then the password MUST be url-encoded, e.g. '*'->%2A, '['->%5B.)
SUPABASE_DB_URL_SESSION=host=aws-0-<region>.pooler.supabase.com port=5432 dbname=postgres user=postgres.<project-ref> password=<raw-password> sslmode=require
# Management API PAT for the health-check verification curl (supademo-readme.md). Not used by containers.
SUPABASE_ACCESS_TOKEN=sbp_xxx
# Direct connection (used only by the Supabase CLI / psql to apply migrations).
SUPABASE_DB_URL_DIRECT=postgres://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase — auth, storage, metrics
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/product-images
# Opt-in: route checkout charges to the payment-charge edge function (deploy it first,
# see supademo-readme.md). Empty = original gRPC path to the local payment service.
PAYMENT_EDGE_FN_URL=https://<project-ref>.supabase.co/functions/v1/payment-charge

# ---------------------------------------------------------------------------
# Sentry — per-service DSNs with a global fallback
# ---------------------------------------------------------------------------
# Global fallback — used by any service whose specific DSN below is blank.
# Leaving all blank disables Sentry entirely (every SDK treats an empty DSN as a no-op).
SENTRY_DSN=https://<key>@o673219.ingest.us.sentry.io/<project-id>
SENTRY_ENVIRONMENT=demo
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=steven-eubank
SENTRY_OTLP_ENDPOINT=https://o673219.ingest.us.sentry.io/api/<project-id>/integration/otlp
# Only needed for source-map upload during the frontend build (not required to run).
SENTRY_AUTH_TOKEN=<org-or-project-token>
SENTRY_PERSONAL_TOKEN=<sentry-personal-token>

# Per-service DSNs — each routes to its own Sentry project (otel-shop-<service>-<lang>).
# Leave a value blank to fall back to the global SENTRY_DSN above.
SENTRY_DSN_FRONTEND=https://ae661f898aa0493a8d0ad4f7df85b494@o673219.ingest.us.sentry.io/4512027274117120
SENTRY_DSN_AD=https://3ec6a31ff240762859a433ab6328d678@o673219.ingest.us.sentry.io/4512044996362240
SENTRY_DSN_CART=https://f0eb273fb74cb99f07cebd08434cfaae@o673219.ingest.us.sentry.io/4512044996296707
SENTRY_DSN_ACCOUNTING=https://7f0d0b947717484186c68b8f02769f1f@o673219.ingest.us.sentry.io/4512044996296706
SENTRY_DSN_CHECKOUT=https://74f442fc5dd75dfa8353973de85b7b6f@o673219.ingest.us.sentry.io/4512044996231168
SENTRY_DSN_PRODUCTCATALOG=https://ba932f3a31c2f58a365a1829f12b5c1a@o673219.ingest.us.sentry.io/4512044996296705
SENTRY_DSN_EMAIL=https://3c135f7b2294463e102b02b0371393e4@o673219.ingest.us.sentry.io/4512044996362245
SENTRY_DSN_PAYMENT=https://e435b901ac92fe624c2882c54d418d3d@o673219.ingest.us.sentry.io/4512044996362244
SENTRY_DSN_QUOTE=https://401f691fc311722aa4f635c8e0db8f30@o673219.ingest.us.sentry.io/4512044996362243
SENTRY_DSN_RECOMMENDATION=https://ae0e1ef658c07ef65ed3d7534d5301f0@o673219.ingest.us.sentry.io/4512044996296710
SENTRY_DSN_SHIPPING=https://3eab07184227c54c0ead25e13c7730f5@o673219.ingest.us.sentry.io/4512044996362242
SENTRY_DSN_FRAUD_DETECTION=https://9fef1098d4e77f0718094e1d4ea6c9e6@o673219.ingest.us.sentry.io/4512045003112448
SENTRY_DSN_PAYMENT_CHARGE=https://7dc305a151da878d4044cc36de452b2b@o673219.ingest.us.sentry.io/4512044996296704
SENTRY_DSN_CURRENCY=https://0c3de878b186cfda168139738699375b@o673219.ingest.us.sentry.io/4512044996362241
SENTRY_DSN_REACT_NATIVE=https://8368312ab968513dcd679a88aff9b2a6@o673219.ingest.us.sentry.io/4512044996296709
# React Native / Expo reads EXPO_PUBLIC_* vars at build time; mirror the value above.
EXPO_PUBLIC_SENTRY_DSN=https://8368312ab968513dcd679a88aff9b2a6@o673219.ingest.us.sentry.io/4512044996296709
