# Template for enabling the Sentry + Supabase integration.
# Copy to `.env.local` (gitignored) and fill in real values, then run `make start`.
# `.env.local` is loaded LAST by the Makefile, so it overrides .env and .env.override.
# Leaving this file absent keeps the default offline demo (bundled Postgres, image-provider,
# anonymous auth, Sentry disabled) working with a plain `docker compose up`.

# ---------------------------------------------------------------------------
# Supabase — database
# ---------------------------------------------------------------------------
# product-catalog (Go / libpq): transaction pooler (:6543), sslmode=require.
# URL-encode special characters in the password (e.g. '*' -> '%2A').
PRODUCT_CATALOG_DB_CONNECTION_STRING=postgres://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# accounting (.NET / Npgsql): session pooler (:5432); Npgsql keyword form (raw password).
ACCOUNTING_DB_CONNECTION_STRING=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Username=postgres.<project-ref>;Password=<password>;Database=postgres;SSL Mode=Require;Trust Server Certificate=true
# load-generator DB-exhaustion task: session pooler (:5432), NOT transaction pooler (:6543).
# Use the libpq keyword/value form (below) so special chars in the password need NO url-encoding.
# (A postgres://user:pass@host/db URL also works, but then the password MUST be url-encoded, e.g. '*'->%2A, '['->%5B.)
SUPABASE_DB_URL_SESSION=host=aws-0-<region>.pooler.supabase.com port=5432 dbname=postgres user=postgres.<project-ref> password=<raw-password> sslmode=require
# Management API PAT for the health-check verification curl (supademo-readme.md). Not used by containers.
SUPABASE_ACCESS_TOKEN=sbp_xxx
# Direct connection (used only by the Supabase CLI / psql to apply migrations).
SUPABASE_DB_URL_DIRECT=postgres://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase — auth, storage, metrics
# ---------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/product-images
# Opt-in: route checkout charges to the payment-charge edge function (deploy it first,
# see supademo-readme.md). Empty = original gRPC path to the local payment service.
PAYMENT_EDGE_FN_URL=https://<project-ref>.supabase.co/functions/v1/payment-charge

# ---------------------------------------------------------------------------
# Sentry — one project / one DSN for the first pass
# ---------------------------------------------------------------------------
SENTRY_DSN=https://<key>@<org-id>.ingest.<region>.sentry.io/<project-id>
SENTRY_ENVIRONMENT=demo
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=<org-slug>
SENTRY_OTLP_ENDPOINT=https://<org-id>.ingest.<region>.sentry.io/api/<project-id>/integration/otlp
# Only needed for source-map upload during the frontend build (not required to run).
SENTRY_AUTH_TOKEN=<org-or-project-token>
SENTRY_PERSONAL_TOKEN=<sentry-person-token>
